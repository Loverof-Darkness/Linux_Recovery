#!/usr/bin/env bash
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  devil_recovery — Fetch-and-Run Launcher
#
#  Run from ANY terminal — downloads DEVIL from GitHub, installs
#  it locally, and launches it. No git required, just curl/wget.
#
#  One-liner install (adds the `devil_recovery` command permanently):
#
#    curl -fsSL https://raw.githubusercontent.com/Loverof-Darkness/Linux_Recovery/main/devil_recovery | sudo bash -s -- --setup
#
#  Or just run it directly (fetches + runs, no permanent install):
#
#    bash <(curl -fsSL https://raw.githubusercontent.com/Loverof-Darkness/Linux_Recovery/main/devil_recovery)
#
#  Usage:
#    devil_recovery              # Fetch (if needed) + launch DEVIL
#    devil_recovery --update     # Force re-download latest from GitHub
#    devil_recovery --uninstall  # Remove DEVIL from this system
#    devil_recovery --setup      # Install the devil_recovery command permanently
#    devil_recovery [flags]      # Any flag is passed through to DEVIL
#
#  GitHub: https://github.com/Loverof-Darkness/Linux_Recovery
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
set -Eeuo pipefail
IFS=$' \t\n'

readonly VERSION="1.0.0"
readonly REPO="Loverof-Darkness/Linux_Recovery"
readonly BRANCH="main"
readonly TARBALL_URL="https://github.com/$REPO/archive/refs/heads/$BRANCH.tar.gz"
readonly RAW_BASE="https://raw.githubusercontent.com/$REPO/$BRANCH"

# Where DEVIL lives on this system
readonly DEVIL_HOME="${DEVIL_HOME:-/opt/devil}"
readonly DEVIL_BIN="$DEVIL_HOME/run.sh"
readonly LAUNCHER_PATH="/usr/local/bin/devil_recovery"

# ── Colors ──────────────────────────────────────────────────────
if [[ -t 1 ]] && [[ -z "${NO_COLOR:-}" ]]; then
    C_RED=$'\e[31m'    C_GREEN=$'\e[32m'  C_YELLOW=$'\e[33m'
    C_CYAN=$'\e[36m'   C_MAGENTA=$'\e[35m'
    C_BOLD=$'\e[1m'    C_DIM=$'\e[2m'     C_RESET=$'\e[0m'
else
    C_RED='' C_GREEN='' C_YELLOW='' C_CYAN='' C_MAGENTA=''
    C_BOLD='' C_DIM='' C_RESET=''
fi

# ── Helpers ─────────────────────────────────────────────────────
fail()    { printf '%s✗ ERROR:%s %s\n' "$C_RED" "$C_RESET" "$*" >&2; exit 1; }
success() { printf '%s✓%s %s\n' "$C_GREEN" "$C_RESET" "$*"; }
info()    { printf '%s●%s %s\n' "$C_CYAN" "$C_RESET" "$*"; }
warn()    { printf '%s⚠%s %s\n' "$C_YELLOW" "$C_RESET" "$*"; }
step()    { printf '%s▸%s %s\n' "$C_MAGENTA" "$C_RESET" "$*"; }

banner() {
    printf '%s' "$C_BOLD$C_RED"
    cat << 'EOF'

    ██████╗ ███████╗██╗   ██╗██╗██╗
    ██╔══██╗██╔════╝██║   ██║██║██║
    ██║  ██║█████╗  ██║   ██║██║██║
    ██║  ██║██╔══╝  ╚██╗ ██╔╝██║██║
    ██████╔╝███████╗ ╚████╔╝ ██║███████╗
    ╚═════╝ ╚══════╝  ╚═══╝  ╚═╝╚══════╝
EOF
    printf '%s       %sFetch & Run Launcher%s\n\n' "$C_RESET" "$C_DIM" "$C_RESET"
}

# ── Detect download tool ────────────────────────────────────────
fetch() {
    # $1 = URL, $2 = output file (or - for stdout)
    local url="$1" out="${2:--}"
    if command -v curl &>/dev/null; then
        if [[ "$out" == "-" ]]; then
            curl -fsSL "$url"
        else
            curl -fsSL -o "$out" "$url"
        fi
    elif command -v wget &>/dev/null; then
        if [[ "$out" == "-" ]]; then
            wget -qO- "$url"
        else
            wget -qO "$out" "$url"
        fi
    else
        fail "Neither curl nor wget found. Install one and try again."
    fi
}

# ── Check if DEVIL is already installed ─────────────────────────
is_installed() {
    [[ -d "$DEVIL_HOME" ]] && [[ -f "$DEVIL_BIN" ]]
}

# ── Download and install DEVIL from GitHub ──────────────────────
download_and_install() {
    local needs_root=false
    local install_dir="$DEVIL_HOME"

    # Check if we need root
    if [[ -d "$install_dir" ]]; then
        [[ -w "$install_dir" ]] || needs_root=true
    else
        local parent_dir
        parent_dir="$(dirname "$install_dir")"
        [[ -w "$parent_dir" ]] || needs_root=true
    fi

    if $needs_root && [[ ${EUID:-999} -ne 0 ]]; then
        warn "Installation to $install_dir requires root privileges."
        info "Re-running with sudo..."
        exec sudo bash "$0" "--install-internal" "$@"
    fi

    step "Downloading DEVIL from GitHub..."
    local tmpdir
    tmpdir=$(mktemp -d "${TMPDIR:-/tmp}/devil-dl.XXXXXX") || fail "Cannot create temp directory"
    trap "rm -rf '$tmpdir'" EXIT

    local tarball="$tmpdir/devil.tar.gz"
    fetch "$TARBALL_URL" "$tarball"

    step "Extracting..."
    tar -xzf "$tarball" -C "$tmpdir" || fail "Failed to extract archive"

    # The archive extracts to Linux_Recovery-main/
    local extracted="$tmpdir/Linux_Recovery-$BRANCH"
    [[ -d "$extracted" ]] || fail "Extracted directory not found"

    step "Installing to $install_dir..."
    # Back up existing installation
    if [[ -d "$install_dir" ]]; then
        local backup="${install_dir}.backup-$(date +%Y%m%d-%H%M%S)"
        mv "$install_dir" "$backup" 2>/dev/null || true
    fi

    # Move into place
    mv "$extracted" "$install_dir"

    # Set permissions
    chown -R root:root "$install_dir" 2>/dev/null || true
    find "$install_dir" -type d -exec chmod 0755 {} + 2>/dev/null || true
    find "$install_dir" -type f \( -name '*.sh' -o -name 'devil' -o -name 'Devil_Recovery' -o -name 'devil_recovery' \) \
        -exec chmod 0755 {} + 2>/dev/null || true

    # Create symlinks for easy access
    if [[ -w /usr/local/bin ]]; then
        ln -sfn "$install_dir/run.sh" /usr/local/bin/devil 2>/dev/null || true
    fi

    trap - EXIT
    rm -rf "$tmpdir"
    success "DEVIL installed to $install_dir"
}

# ── Setup: install devil_recovery command permanently ───────────
setup_command() {
    banner
    info "Setting up the 'devil_recovery' command system-wide..."

    if [[ ${EUID:-999} -ne 0 ]]; then
        warn "Setup requires root privileges."
        exec sudo bash "$0" "--setup"
    fi

    # Download this script itself and install it
    step "Installing devil_recovery to $LAUNCHER_PATH..."
    local self_url="$RAW_BASE/devil_recovery"
    fetch "$self_url" "$LAUNCHER_PATH"
    chmod 0755 "$LAUNCHER_PATH"

    success "Done! The 'devil_recovery' command is now available system-wide."
    printf '\n'
    printf '  %sUsage:%s\n' "$C_BOLD" "$C_RESET"
    printf '    %sdevil_recovery%s              Launch DEVIL (auto-downloads if needed)\n' "$C_CYAN" "$C_RESET"
    printf '    %sdevil_recovery --update%s     Force update to latest version\n' "$C_CYAN" "$C_RESET"
    printf '    %sdevil_recovery --uninstall%s  Remove DEVIL completely\n' "$C_CYAN" "$C_RESET"
    printf '    %sdevil_recovery --diagnose%s   Run read-only diagnostics\n' "$C_CYAN" "$C_RESET"
    printf '\n'
    exit 0
}

# ── Uninstall ───────────────────────────────────────────────────
do_uninstall() {
    if [[ ${EUID:-999} -ne 0 ]]; then
        warn "Uninstallation requires root privileges."
        exec sudo bash "$0" "--uninstall"
    fi

    banner
    info "Uninstalling DEVIL..."

    if [[ -f "$DEVIL_HOME/uninstall.sh" ]]; then
        bash "$DEVIL_HOME/uninstall.sh"
    else
        rm -rf "$DEVIL_HOME" 2>/dev/null || true
        rm -f /usr/local/bin/devil 2>/dev/null || true
        rm -f /usr/local/bin/Devil_Recovery 2>/dev/null || true
    fi

    rm -f "$LAUNCHER_PATH" 2>/dev/null || true
    success "DEVIL has been removed."
    info "User data preserved in ~/.local/state/devil/ and ~/.config/devil/"
    exit 0
}

# ── Launch DEVIL ────────────────────────────────────────────────
launch() {
    if [[ -x "$DEVIL_BIN" ]]; then
        exec "$DEVIL_BIN" "$@"
    elif [[ -f "$DEVIL_BIN" ]]; then
        exec bash "$DEVIL_BIN" "$@"
    else
        fail "DEVIL binary not found at $DEVIL_BIN — try: devil_recovery --update"
    fi
}

# ── Main ────────────────────────────────────────────────────────
main() {
    case "${1:-}" in
        --setup)
            setup_command
            ;;
        --uninstall)
            do_uninstall
            ;;
        --update)
            shift
            banner
            info "Updating DEVIL to the latest version..."
            download_and_install "$@"
            printf '\n'
            success "Update complete! Launching DEVIL..."
            printf '\n'
            launch "$@"
            ;;
        --install-internal)
            # Internal: called after sudo re-exec
            shift
            download_and_install "$@"
            exit 0
            ;;
        --version|-V)
            printf 'devil_recovery launcher v%s\n' "$VERSION"
            exit 0
            ;;
        *)
            if is_installed; then
                # Already have DEVIL — just run it
                launch "$@"
            else
                # First run — download, install, launch
                banner
                info "DEVIL is not installed. Fetching from GitHub..."
                printf '\n'
                download_and_install "$@"
                printf '\n'
                success "Ready! Launching DEVIL..."
                printf '\n'
                launch "$@"
            fi
            ;;
    esac
}

main "$@"
